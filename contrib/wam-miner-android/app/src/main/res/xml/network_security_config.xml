<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config>
        <!-- Trust your specific domain -->
        <domain includeSubdomains="true">wamnode.vslabs.co.in</domain>
        <trust-anchors>
            <!-- Trust standard system certificates -->
            <certificates src="system" />
            <!-- Bypass certificate validation constraints exclusively for this domain -->
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
